{
  "api": {
    "groqWhisperUrl": "https://api.groq.com/openai/v1/audio/transcriptions",
    "whisperModel": "whisper-large-v3",
    "temperature": 0.0,
    "responseFormat": "verbose_json",
    "maxFileSizeBytes": 26214400,
    "timeoutMinutes": 5,
    "retries": 3,
    "retryStatuses": [429, 500, 502, 503, 504]
  },
  "transcription": {
    "pipeline": ["groq", "gemini"],
    "maxPromptLengthChars": 448,
    "providers": {
      "groq": {
        "baseUrl": "https://api.groq.com/openai/v1/audio/transcriptions",
        "model": "whisper-large-v3",
        "temperature": 0.0,
        "responseFormat": "verbose_json",
        "timestampGranularities": "segment",
        "timeoutSeconds": 300,
        "maxUploadBytes": 26214400
      },
      "gemini": {
        "baseUrl": "https://generativelanguage.googleapis.com/v1beta/models",
        "model": "gemini-1.5-flash",
        "temperature": 0.0,
        "timeoutSeconds": 180,
        "maxUploadBytes": 20971520
      }
    },
    "qualityFilter": {
      "maxNoSpeechProb": 0.6,
      "minAvgLogprob": -1.0,
      "maxCompressionRatio": 2.4,
      "dropConsecutiveDuplicates": true
    },
    "retry": {
      "maxRetries": 3,
      "initialBackoffMs": 1000,
      "maxBackoffMs": 10000,
      "backoffMultiplier": 2.0,
      "retryStatuses": [429, 500, 502, 503, 504],
      "maxRetryAfterSeconds": 60
    }
  },
  "audio": {
    "sampleRate": 16000,
    "numChannels": 1,
    "encoder": "aacLc",
    "bitRate": 64000,
    "noiseSuppress": true,
    "echoCancel": true,
    "autoGain": true,
    "safetyRatio": 0.9,
    "recordingsFolder": "transcriptions",
    "amplitudeIntervalMs": 100,
    "secondsIntervalMs": 1000,
    "minDb": -160.0,
    "maxDb": 0.0,
    "waveHistoryLimit": 45,
    "fileNamePrefix": "rec_",
    "fileExtension": ".m4a"
  },
  "speechToText": {
    "listenForHours": 1,
    "pauseForSeconds": 10,
    "listenMode": "dictation",
    "restartDelayMs": 300,
    "maxRestarts": 3,
    "enabledByDefault": true
  },
  "languages": [
    {
      "id": "bilingual",
      "code": "bilingual",
      "storedName": "Bilingual",
      "name": "Bilingual (Tamil + English)",
      "uiLabel": "Bilingual",
      "displayName": "Bilingual",
      "speechLocale": "ta-IN",
      "sttLocale": "ta-IN",
      "whisperLanguage": "ta",
      "promptKey": "bilingual_prompt",
      "promptSampleSentence": "வணக்கம், today we discuss the project update and next steps.",
      "whisperPrompt": "வணக்கம், today we discuss the project update and next steps.",
      "allowedDetectedLanguages": ["ta", "en"],
      "retryLanguage": "ta",
      "customVocabulary": ["Flutter", "Riverpod", "Groq", "Whisper", "Firestore", "Firebase"]
    },
    {
      "id": "ta-IN",
      "code": "ta-IN",
      "storedName": "Tamil",
      "name": "Tamil (தமிழ்)",
      "uiLabel": "Tamil",
      "displayName": "Tamil",
      "speechLocale": "ta-IN",
      "sttLocale": "ta-IN",
      "whisperLanguage": "ta",
      "promptKey": "tamil_prompt",
      "promptSampleSentence": "வணக்கம், இன்றைய கூட்டத்தில் திட்டத்தின் முன்னேற்றம் பற்றி பேசுகிறோம்.",
      "whisperPrompt": "வணக்கம், இன்றைய கூட்டத்தில் திட்டத்தின் முன்னேற்றம் பற்றி பேசுகிறோம்.",
      "allowedDetectedLanguages": ["ta"],
      "retryLanguage": "ta",
      "customVocabulary": ["வணக்கம்", "செயலி", "பதிவு"]
    },
    {
      "id": "en-US",
      "code": "en-US",
      "storedName": "English",
      "name": "English (United States)",
      "uiLabel": "English",
      "displayName": "English",
      "speechLocale": "en-US",
      "sttLocale": "en-US",
      "whisperLanguage": "en",
      "promptKey": "english_prompt",
      "promptSampleSentence": "Hello, today we are discussing the project progress and next milestones.",
      "whisperPrompt": "Hello, today we are discussing the project progress and next milestones.",
      "allowedDetectedLanguages": ["en"],
      "retryLanguage": "en",
      "customVocabulary": ["transcription", "audio", "recording"]
    }
  ],
  "firestore": {
    "collectionUsers": "users",
    "collectionTranscriptions": "transcriptions",
    "collectionExports": "exports",
    "pageSize": 20,
    "cachePersistenceEnabled": true,
    "cacheSizeBytesUnlimited": true
  },
  "storage": {
    "exportsPathPattern": "users/{userId}/exports/{transcriptionId}/{fileName}"
  },
  "preferences": {
    "keyThemeMode": "theme_mode",
    "keyUserLanguage": "user_language",
    "keyLivePreviewEnabled": "live_preview_enabled",
    "keyLegacyCustomApiKey": "groq_api_key_custom"
  },
  "secrets": {
    "secureStorageKeyGroqApiKey": "secure_groq_api_key",
    "secureStorageKeyGeminiApiKey": "secure_gemini_api_key",
    "secureStorageKeyGoogleTranslateApiKey": "secure_google_translate_api_key",
    "dartDefineKeyGroqApiKey": "GROQ_API_KEY",
    "dartDefineKeyGeminiApiKey": "GEMINI_API_KEY",
    "dartDefineKeyGoogleTranslateApiKey": "GOOGLE_TRANSLATE_API_KEY"
  },
  "export": {
    "pdfFontUrl": "https://raw.githubusercontent.com/googlefonts/noto-fonts/main/hinted/ttf/NotoSansTamil/NotoSansTamil-Regular.ttf",
    "defaultPdfFileName": "transcript.pdf",
    "defaultTxtFileName": "transcript.txt",
    "defaultDocFileName": "transcript.doc",
    "pdfPageMargin": 24.0,
    "pdfHeaderFontSize": 18.0,
    "pdfBodyFontSize": 12.0,
    "pdfMetadataFontSize": 10.0,
    "pdfAccentColorHex": "#6C5CE7"
  },
  "branding": {
    "logoBlack": "assets/branding/logo_black.png",
    "logoWhite": "assets/branding/logo_white.png",
    "iconFull": "assets/branding/icon_full.png",
    "iconForeground": "assets/branding/icon_foreground.png",
    "appName": "Scribly"
  }
}
